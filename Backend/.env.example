# Sao chép file này thành .env (đã được gitignore) và điền giá trị thật.
# Spring Boot KHÔNG tự đọc file .env – hãy nạp vào biến môi trường (xem README mục 4).

DB_URL=jdbc:postgresql://localhost:5432/chungcu_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Tạo bằng: openssl rand -base64 32
JWT_SECRET=your_base64_secret_at_least_32_bytes
